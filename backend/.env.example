# Copy to .env locally; never commit real secrets or tokens.
# API server
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Supabase project — prototype/testing only, use fictitious data.
# Obtain the project URL from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
# Publishable/anon key may be used only where needed; never use service_role in a browser.
SUPABASE_ANON_KEY=
# Server-side PostgreSQL connection string is a secret; keep it only in local env/secret manager.
DATABASE_URL=

# OIDC/JWT validation. Fill only after verifying the project's actual Auth configuration.
# Do not assume these values without checking the Supabase dashboard and JWT settings.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
