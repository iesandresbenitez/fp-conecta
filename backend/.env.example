# Copy to .env locally; never commit real secrets or tokens.
# API server
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# OIDC/JWT settings for the selected managed identity provider.
# Keep unset until a provider/tenant has been approved; protected routes fail closed.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Database connection will be added after hosting/provider review.
# DATABASE_URL=
